---
import Page from '../layouts/Page.astro';
import { CONTACT_URL } from '../config/contact';
---

<Page title="Photography" description="Editorial, portrait, and lifestyle photography by Emily Rose Doud — warm, botanical, and intentional.">

  <!-- Hero -->
  <section class="section-padded pb-section-sm">
    <div class="container-content">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 mb-6">
        <img
          src="/images/photography-logo.jpg"
          alt="Photography logo"
          class="w-24 h-24 object-contain rounded-xl"
        />
        <div>
          <p class="text-label mb-2 reveal">Creative Work</p>
          <h1 class="font-display text-display-lg text-brown reveal reveal-delay-1">Photography</h1>
        </div>
      </div>
      <p class="text-body-lg max-w-2xl reveal reveal-delay-2">
        Editorial, portrait, and lifestyle photography. My work has a warm, botanical quality —
        natural light, honest moments, intentional composition.
      </p>
    </div>
  </section>

  <!-- Sessions -->
  <section class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <h2 class="font-display text-display-md text-brown ruled-heading mb-10 reveal">What I Shoot</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

        <!-- Portraits & People -->
        <div class="reveal reveal-delay-1">
          <p class="text-label mb-4">Portraits & People</p>
          <ul class="space-y-4">
            {[
              { title: 'Senior portraits',              desc: 'Marking the milestone with images that capture your graduate\'s personality' },
              { title: 'Individual & personal portraits', desc: 'Updated photos for any purpose or occasion' },
              { title: 'Family photography',            desc: 'Relaxed, natural sessions that capture your family as it is right now' },
              { title: 'Awkward family photo sessions', desc: 'Embrace the chaos — stiff poses, mismatched outfits, and all the beautiful weirdness that makes your family yours' },
              { title: 'Couples & engagement sessions', desc: 'For the moments worth remembering' },
              { title: 'Maternity & newborn',           desc: 'Gentle sessions documenting a new chapter' },
              { title: 'Pet photography',               desc: 'Because they\'re family too' },
              { title: 'Boudoir sessions',              desc: 'Empowering, tasteful portraits that celebrate confidence and beauty on your own terms — a safe and comfortable experience from start to finish' },
            ].map(item => (
              <li>
                <p class="font-serif text-brown">{item.title}</p>
                <p class="text-body text-sm">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>

        <!-- Professional & Business -->
        <div class="reveal reveal-delay-2">
          <p class="text-label mb-4">Professional & Business</p>
          <ul class="space-y-4">
            {[
              { title: 'Professional headshots',        desc: 'Polished, current images for LinkedIn, websites, and bios' },
              { title: 'Team & group headshots',        desc: 'Consistent, professional photos for your whole staff' },
              { title: 'Business & brand photography',  desc: 'Product, marketing, and storytelling images for your business' },
              { title: 'Real estate & property',        desc: 'Bright, well-composed listing photos that help properties sell' },
            ].map(item => (
              <li>
                <p class="font-serif text-brown">{item.title}</p>
                <p class="text-body text-sm">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>

        <!-- Events -->
        <div class="reveal reveal-delay-3">
          <p class="text-label mb-4">Events</p>
          <ul class="space-y-4">
            {[
              { title: 'Private events & celebrations', desc: 'Parties, anniversaries, reunions, and gatherings' },
              { title: 'Corporate events & conferences', desc: 'Professional coverage of your business events' },
              { title: 'Graduation & school events',    desc: 'Capturing the day for students and families' },
              { title: 'Sporting events',               desc: 'Action shots, team photos, and sideline coverage that capture the energy of the game' },
            ].map(item => (
              <li>
                <p class="font-serif text-brown">{item.title}</p>
                <p class="text-body text-sm">{item.desc}</p>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Portrait section -->
  <section class="section-padded">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start">
        <div>
          <div class="flex flex-wrap gap-2 mb-8 reveal">
            <span class="tag-sage">Portrait</span>
            <span class="tag-sage">Editorial</span>
            <span class="tag-sage">Lifestyle</span>
            <span class="tag-sage">Product</span>
            <span class="tag-sage">Promotional</span>
          </div>
          <p class="text-body-lg mb-4 reveal reveal-delay-1">
            Every session starts with a conversation. I want to understand what you're trying to
            say before I pick up a camera — whether that's a brand shoot, a portrait session, or
            editorial work.
          </p>
          <p class="text-body reveal reveal-delay-2">
            The studio comes to you. Whether it's the comfort of your home, a sun-drenched park,
            or a location that holds meaning — I'll bring the eye, the equipment, and the vision.
            You bring the place.
          </p>
        </div>

        <!-- Portrait carousel of carousels -->
        <div class="reveal reveal-delay-1">

          <!-- Gallery 1: Claire 1–6 -->
          <div id="portrait-page-0" class="portrait-page">
            <div id="carousel-0" class="relative rounded-xl overflow-hidden">
              <div class="relative aspect-[3/4]">
                {[
                  { src: '/images/photography/claire-1.jpg', alt: 'Portrait — Claire' },
                  { src: '/images/photography/claire-2.jpg', alt: 'Portrait — Claire' },
                  { src: '/images/photography/claire-3.jpg', alt: 'Portrait — Claire' },
                  { src: '/images/photography/claire-4.jpg', alt: 'Portrait — Claire' },
                  { src: '/images/photography/claire-5.jpg', alt: 'Portrait — Claire' },
                  { src: '/images/photography/claire-6.jpg', alt: 'Portrait — Claire' },
                ].map((photo, i) => (
                  <button
                    class={`p0-slide lightbox-trigger absolute inset-0 w-full h-full transition-opacity duration-700 cursor-zoom-in ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                    data-src={photo.src} data-alt={photo.alt}
                    aria-label={`View full size: ${photo.alt}`}
                  >
                    <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" />
                  </button>
                ))}
              </div>
              <button id="carousel-0-prev" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8249;</button>
              <button id="carousel-0-next" aria-label="Next photo"     class="absolute right-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8250;</button>
            </div>
            <div class="flex justify-center gap-2 mt-3">
              {[0,1,2,3,4,5].map(i => (
                <button class={`p0-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-rose-deep' : 'bg-brown/20'}`} data-index={i} aria-label={`Go to photo ${i + 1}`}></button>
              ))}
            </div>
          </div>

          <!-- Gallery 2: Claire 7, Cassie, Marley 1 & 2 edited -->
          <div id="portrait-page-1" class="portrait-page hidden">
            <div id="carousel-1" class="relative rounded-xl overflow-hidden">
              <div class="relative aspect-[3/4]">
                {[
                  { src: '/images/photography/claire-7.jpg',        alt: 'Portrait — Claire' },
                  { src: '/images/photography/cassie.jpg',           alt: 'Portrait — Cassie' },
                  { src: '/images/photography/marley-1-edited.jpg',  alt: 'Portrait — Marley' },
                  { src: '/images/photography/marley-2-edited.jpg',  alt: 'Portrait — Marley' },
                ].map((photo, i) => (
                  <button
                    class={`p1-slide lightbox-trigger absolute inset-0 w-full h-full transition-opacity duration-700 cursor-zoom-in ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                    data-src={photo.src} data-alt={photo.alt}
                    aria-label={`View full size: ${photo.alt}`}
                  >
                    <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" />
                  </button>
                ))}
              </div>
              <button id="carousel-1-prev" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8249;</button>
              <button id="carousel-1-next" aria-label="Next photo"     class="absolute right-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8250;</button>
            </div>
            <div class="flex justify-center gap-2 mt-3">
              {[0,1,2,3].map(i => (
                <button class={`p1-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-rose-deep' : 'bg-brown/20'}`} data-index={i} aria-label={`Go to photo ${i + 1}`}></button>
              ))}
            </div>
          </div>

          <!-- Gallery switcher -->
          <div class="flex items-center justify-center gap-4 mt-5">
            <button id="gallery-prev" class="text-brown-light hover:text-rose-deep transition-colors text-xl leading-none">&#8249;</button>
            <button class="gallery-btn w-2 h-2 rounded-full bg-rose-deep transition-colors" data-page="0" aria-label="Gallery 1"></button>
            <button class="gallery-btn w-2 h-2 rounded-full bg-brown/20 transition-colors" data-page="1" aria-label="Gallery 2"></button>
            <button id="gallery-next" class="text-brown-light hover:text-rose-deep transition-colors text-xl leading-none">&#8250;</button>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Landscape section -->
  <section class="section-padded bg-sage-pale/40 border-y border-sage/20">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <div>
          <p class="text-label mb-3 reveal">Landscape</p>
          <h2 class="font-display text-display-md text-brown ruled-heading mb-6 reveal reveal-delay-1">
            Capturing Wisconsin's<br />Natural Beauty
          </h2>
          <p class="text-body-lg reveal reveal-delay-2">
            Wisconsin has a quiet, unhurried beauty — golden fields, still water, and skies
            that stretch wide. This collection grows with every season, every drive, and
            every moment worth stopping for.
          </p>
        </div>

        <!-- Landscape carousel -->
        <div class="reveal reveal-delay-1">
          <div id="landscape-carousel" class="relative rounded-xl overflow-hidden">
            <div class="relative aspect-[4/3]">
              {[
                { src: '/images/photography/landscape-1.jpg', alt: 'Wisconsin landscape' },
                { src: '/images/photography/landscape-2.jpg', alt: 'Wisconsin landscape' },
                { src: '/images/photography/landscape-3.jpg', alt: 'Wisconsin landscape' },
                { src: '/images/photography/landscape-4.jpg', alt: 'Wisconsin deer' },
                { src: '/images/photography/landscape-5.jpg', alt: 'Wisconsin outdoors' },
                { src: '/images/photography/landscape-6.jpg', alt: 'Blood moon over Wisconsin' },
                { src: '/images/photography/landscape-7.jpg', alt: 'Wisconsin' },
                { src: '/images/photography/bird.jpg',        alt: 'Wisconsin bird' },
              ].map((photo, i) => (
                <button
                  class={`landscape-slide lightbox-trigger absolute inset-0 w-full h-full transition-opacity duration-700 cursor-zoom-in ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                  data-src={photo.src}
                  data-alt={photo.alt}
                  aria-label={`View full size: ${photo.alt}`}
                >
                  <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
            <button id="landscape-prev" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8249;</button>
            <button id="landscape-next" aria-label="Next photo"     class="absolute right-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8250;</button>
          </div>
          <div id="landscape-dots" class="flex justify-center gap-2 mt-3">
            {[0,1,2,3,4,5,6].map(i => (
              <button
                class={`landscape-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-sage-dark' : 'bg-sage/30'}`}
                data-index={i}
                aria-label={`Go to photo ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- On the Scene section -->
  <section class="section-padded bg-rose-pale/50 border-y border-rose-deep/10">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <div>
          <p class="text-label mb-3 reveal">Photojournalism</p>
          <h2 class="font-display text-display-md text-brown ruled-heading mb-6 reveal reveal-delay-1">
            On the Scene
          </h2>
          <p class="text-body-lg reveal reveal-delay-2">
            Documenting moments as they happen — community events, local stories, and the
            people behind them. Real moments, honest frames.
          </p>
        </div>

        <!-- News carousel -->
        <div class="reveal reveal-delay-1">
          <div id="news-carousel" class="relative rounded-xl overflow-hidden">
            <div class="relative aspect-[4/3]">
              {[
                { src: '/images/photography/news-1.jpg', alt: 'On the scene' },
                { src: '/images/photography/news-2.jpg', alt: 'On the scene' },
                { src: '/images/photography/news-3.jpg', alt: 'On the scene' },
                { src: '/images/photography/news-4.jpg', alt: 'Rodeo' },
              ].map((photo, i) => (
                <button
                  class={`news-slide lightbox-trigger absolute inset-0 w-full h-full transition-opacity duration-700 cursor-zoom-in ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                  data-src={photo.src}
                  data-alt={photo.alt}
                  aria-label={`View full size: ${photo.alt}`}
                >
                  <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
            <button id="news-prev" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8249;</button>
            <button id="news-next" aria-label="Next photo"     class="absolute right-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8250;</button>
          </div>
          <div id="news-dots" class="flex justify-center gap-2 mt-3">
            {[0,1,2,3].map(i => (
              <button
                class={`news-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-rose-deep' : 'bg-rose-deep/20'}`}
                data-index={i}
                aria-label={`Go to photo ${i + 1}`}
              ></button>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <h2 class="font-display text-display-md text-brown ruled-heading mb-6 reveal">Pricing</h2>
      <p class="text-body-lg max-w-xl reveal reveal-delay-1">
        Pricing varies based on the type of session, location, and deliverables.
        Reach out and we'll find something that works for you.
      </p>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href={CONTACT_URL}
        class="btn-primary mt-8 inline-flex reveal reveal-delay-2"
      >
        Email for Pricing →
      </a>
    </div>
  </section>

  <!-- Pet Photos section -->
  <section class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <div>
          <p class="text-label mb-3 reveal">Furry Friends</p>
          <h2 class="font-display text-display-md text-brown ruled-heading mb-6 reveal reveal-delay-1">
            Pet Photos
          </h2>
          <p class="text-body-lg reveal reveal-delay-2">
            Because they're family too. Capturing the personality and charm of your pets —
            from sleepy afternoons to full-speed zoomies.
          </p>
        </div>

        <!-- Pet carousel -->
        <div class="reveal reveal-delay-1">
          <div id="pet-carousel" class="relative rounded-xl overflow-hidden">
            <div class="relative aspect-[3/4]">
              {[
                { src: '/images/photography/pup.jpg',   alt: 'Pet portrait' },
                { src: '/images/photography/pup-1.jpg', alt: 'Pet portrait' },
                { src: '/images/photography/pup-3.jpg', alt: 'Pet portrait' },
              ].map((photo, i) => (
                <button
                  class={`pet-slide lightbox-trigger absolute inset-0 w-full h-full transition-opacity duration-700 cursor-zoom-in ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                  data-src={photo.src} data-alt={photo.alt}
                  aria-label={`View full size: ${photo.alt}`}
                >
                  <img src={photo.src} alt={photo.alt} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
            <button id="pet-prev" aria-label="Previous photo" class="absolute left-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8249;</button>
            <button id="pet-next" aria-label="Next photo"     class="absolute right-2 top-1/2 -translate-y-1/2 bg-cream/80 hover:bg-cream text-brown rounded-full w-9 h-9 flex items-center justify-center shadow transition-colors">&#8250;</button>
          </div>
          <div class="flex justify-center gap-2 mt-3">
            {[0,1,2].map(i => (
              <button class={`pet-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-rose-deep' : 'bg-brown/20'}`} data-index={i} aria-label={`Go to photo ${i + 1}`}></button>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padded">
    <div class="container-content text-center">
      <h2 class="font-display text-display-md text-brown mb-6 reveal">Book a Session</h2>
      <p class="text-body-lg max-w-md mx-auto mb-8 reveal reveal-delay-1">
        Ready to work together? Let's talk about availability and creative vision.
      </p>
      <a target="_blank" rel="noopener noreferrer" href={CONTACT_URL} class="btn-primary reveal reveal-delay-2">
        Get in Touch →
      </a>
    </div>
  </section>

<!-- Lightbox -->
<div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-brown-deep/90 backdrop-blur-sm p-4" role="dialog" aria-modal="true">
  <button id="lightbox-close" class="absolute top-4 right-4 text-cream/70 hover:text-cream text-3xl leading-none" aria-label="Close">&times;</button>
  <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] rounded-xl shadow-card-hover object-contain" />
</div>

<script>
  // ── Portrait gallery (carousel of carousels) ──
  function makeCarousel(pageIndex: number) {
    const slides    = document.querySelectorAll<HTMLElement>(`.p${pageIndex}-slide`);
    const dots      = document.querySelectorAll<HTMLElement>(`.p${pageIndex}-dot`);
    const prev      = document.getElementById(`carousel-${pageIndex}-prev`)!;
    const next      = document.getElementById(`carousel-${pageIndex}-next`)!;
    const container = document.getElementById(`carousel-${pageIndex}`)!;
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.replace('opacity-100', 'opacity-0');
      dots[current].classList.replace('bg-rose-deep', 'bg-brown/20');
      current = (index + slides.length) % slides.length;
      slides[current].classList.replace('opacity-0', 'opacity-100');
      dots[current].classList.replace('bg-brown/20', 'bg-rose-deep');
    }

    function start() { timer = setInterval(() => goTo(current + 1), 4000); }
    function stop()  { clearInterval(timer); }

    prev.addEventListener('click', (e) => { e.stopPropagation(); stop(); goTo(current - 1); start(); });
    next.addEventListener('click', (e) => { e.stopPropagation(); stop(); goTo(current + 1); start(); });
    dots.forEach(dot => dot.addEventListener('click', () => { stop(); goTo(Number(dot.dataset.index)); start(); }));
    container.addEventListener('mouseenter', stop);
    container.addEventListener('mouseleave', start);

    return { start, stop };
  }

  const carousels = [makeCarousel(0), makeCarousel(1)];
  const pages     = [document.getElementById('portrait-page-0')!, document.getElementById('portrait-page-1')!];
  const galleryBtns = document.querySelectorAll<HTMLElement>('.gallery-btn');
  let activePage  = 0;
  carousels[0].start();

  function switchPage(index: number) {
    carousels[activePage].stop();
    pages[activePage].classList.add('hidden');
    galleryBtns[activePage].classList.replace('bg-rose-deep', 'bg-brown/20');
    activePage = (index + pages.length) % pages.length;
    pages[activePage].classList.remove('hidden');
    galleryBtns[activePage].classList.replace('bg-brown/20', 'bg-rose-deep');
    carousels[activePage].start();
  }

  document.getElementById('gallery-prev')!.addEventListener('click', () => switchPage(activePage - 1));
  document.getElementById('gallery-next')!.addEventListener('click', () => switchPage(activePage + 1));
  galleryBtns.forEach(btn => btn.addEventListener('click', () => switchPage(Number(btn.dataset.page))));

  // ── Landscape Carousel ──
  const lSlides  = document.querySelectorAll<HTMLElement>('.landscape-slide');
  const lDots    = document.querySelectorAll<HTMLElement>('.landscape-dot');
  const lPrev    = document.getElementById('landscape-prev')!;
  const lNext    = document.getElementById('landscape-next')!;
  const lCarousel = document.getElementById('landscape-carousel')!;
  let lCurrent   = 0;
  let lTimer: ReturnType<typeof setInterval>;

  function lGoTo(index: number) {
    lSlides[lCurrent].classList.replace('opacity-100', 'opacity-0');
    lDots[lCurrent].classList.replace('bg-sage-dark', 'bg-sage/30');
    lCurrent = (index + lSlides.length) % lSlides.length;
    lSlides[lCurrent].classList.replace('opacity-0', 'opacity-100');
    lDots[lCurrent].classList.replace('bg-sage/30', 'bg-sage-dark');
  }

  function lStart() { lTimer = setInterval(() => lGoTo(lCurrent + 1), 5000); }
  function lStop()  { clearInterval(lTimer); }

  lPrev.addEventListener('click', (e) => { e.stopPropagation(); lStop(); lGoTo(lCurrent - 1); lStart(); });
  lNext.addEventListener('click', (e) => { e.stopPropagation(); lStop(); lGoTo(lCurrent + 1); lStart(); });
  lDots.forEach(dot => {
    dot.addEventListener('click', () => { lStop(); lGoTo(Number(dot.dataset.index)); lStart(); });
  });
  lCarousel.addEventListener('mouseenter', lStop);
  lCarousel.addEventListener('mouseleave', lStart);
  lStart();

  // ── News Carousel ──
  const nSlides   = document.querySelectorAll<HTMLElement>('.news-slide');
  const nDots     = document.querySelectorAll<HTMLElement>('.news-dot');
  const nPrev     = document.getElementById('news-prev')!;
  const nNext     = document.getElementById('news-next')!;
  const nCarousel = document.getElementById('news-carousel')!;
  let nCurrent    = 0;
  let nTimer: ReturnType<typeof setInterval>;

  function nGoTo(index: number) {
    if (nSlides.length <= 1) return;
    nSlides[nCurrent].classList.replace('opacity-100', 'opacity-0');
    nDots[nCurrent].classList.replace('bg-rose-deep', 'bg-rose-deep/20');
    nCurrent = (index + nSlides.length) % nSlides.length;
    nSlides[nCurrent].classList.replace('opacity-0', 'opacity-100');
    nDots[nCurrent].classList.replace('bg-rose-deep/20', 'bg-rose-deep');
  }

  function nStart() { if (nSlides.length > 1) nTimer = setInterval(() => nGoTo(nCurrent + 1), 5000); }
  function nStop()  { clearInterval(nTimer); }

  nPrev.addEventListener('click', (e) => { e.stopPropagation(); nStop(); nGoTo(nCurrent - 1); nStart(); });
  nNext.addEventListener('click', (e) => { e.stopPropagation(); nStop(); nGoTo(nCurrent + 1); nStart(); });
  nDots.forEach(dot => {
    dot.addEventListener('click', () => { nStop(); nGoTo(Number(dot.dataset.index)); nStart(); });
  });
  nCarousel.addEventListener('mouseenter', nStop);
  nCarousel.addEventListener('mouseleave', nStart);
  nStart();

  // ── Pet Carousel ──
  const petSlides  = document.querySelectorAll<HTMLElement>('.pet-slide');
  const petDots    = document.querySelectorAll<HTMLElement>('.pet-dot');
  const petPrev    = document.getElementById('pet-prev')!;
  const petNext    = document.getElementById('pet-next')!;
  const petCarousel = document.getElementById('pet-carousel')!;
  let petCurrent   = 0;
  let petTimer: ReturnType<typeof setInterval>;

  function petGoTo(index: number) {
    petSlides[petCurrent].classList.replace('opacity-100', 'opacity-0');
    petDots[petCurrent].classList.replace('bg-rose-deep', 'bg-brown/20');
    petCurrent = (index + petSlides.length) % petSlides.length;
    petSlides[petCurrent].classList.replace('opacity-0', 'opacity-100');
    petDots[petCurrent].classList.replace('bg-brown/20', 'bg-rose-deep');
  }

  function petStart() { petTimer = setInterval(() => petGoTo(petCurrent + 1), 4000); }
  function petStop()  { clearInterval(petTimer); }

  petPrev.addEventListener('click', (e) => { e.stopPropagation(); petStop(); petGoTo(petCurrent - 1); petStart(); });
  petNext.addEventListener('click', (e) => { e.stopPropagation(); petStop(); petGoTo(petCurrent + 1); petStart(); });
  petDots.forEach(dot => {
    dot.addEventListener('click', () => { petStop(); petGoTo(Number(dot.dataset.index)); petStart(); });
  });
  petCarousel.addEventListener('mouseenter', petStop);
  petCarousel.addEventListener('mouseleave', petStart);
  petStart();

  // ── Lightbox ──
  const lightbox = document.getElementById('lightbox')!;
  const lbImg    = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close')!;

  function openLightbox(src: string, alt: string) {
    lbImg.src = src;
    lbImg.alt = alt;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.lightbox-trigger').forEach(btn => {
    btn.addEventListener('click', () => openLightbox(btn.dataset.src!, btn.dataset.alt!));
  });

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
</script>

</Page>
