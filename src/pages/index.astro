---
import Page from '../layouts/Page.astro';
import { CONTACT_URL } from '../config/contact';
---

<Page
  title="Doud Co"
  description="Freelance writing, journalism, and photography by Emily Rose Doud."
>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative min-h-[95vh] flex items-center overflow-hidden bg-brown">

    <!-- Background texture -->
    <div class="absolute inset-0 bg-noise opacity-30" aria-hidden="true"></div>
    <!-- Warm glow -->
    <div class="absolute top-0 right-0 w-2/3 h-full bg-gradient-to-bl from-rose-deep/20 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-1/2 h-1/2 bg-gradient-to-tr from-brown-deep/40 via-transparent to-transparent" aria-hidden="true"></div>

    <div class="relative section-padded w-full py-24">
      <div class="container-content grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Copy -->
        <div>
          <p class="text-label text-rose-light mb-6 tracking-[0.25em] reveal">Emily Rose Doud</p>

          <h1 class="font-display leading-[0.95] mb-8 reveal reveal-delay-1">
            <span class="block text-cream" style="font-size: clamp(3.5rem, 9vw, 7rem);">DOUD</span>
            <span class="block text-rose-deep" style="font-size: clamp(3.5rem, 9vw, 7rem);">Co</span>
          </h1>

          <div class="w-16 h-px bg-rose-deep mb-8 reveal reveal-delay-2"></div>

          <p class="text-cream/80 text-lg max-w-sm mb-4 reveal reveal-delay-2 font-serif italic">
            "The story is always in the details."
          </p>
          <p class="text-cream/60 text-sm max-w-sm mb-10 reveal reveal-delay-3">
            Freelance writer &amp; journalist. Photographer. Wisconsin-based.
          </p>

          <div class="flex flex-wrap gap-4 reveal reveal-delay-3">
            <a href="/about" class="btn-primary bg-rose-deep hover:bg-rose-mid border-rose-deep">Meet Emily</a>
            <a href="https://www.emilydoudphotography.com" target="_blank" rel="noopener noreferrer" class="btn-ghost border-cream/30 text-cream hover:border-rose-light hover:text-rose-light">Photography →</a>
          </div>
        </div>

        <!-- Editorial photo -->
        <div class="relative flex justify-center lg:justify-end reveal reveal-delay-2">
          <div class="relative">
            <!-- Accent border offset -->
            <div class="absolute -bottom-3 -right-3 w-full h-full border-2 border-rose-deep/50 rounded-xl" aria-hidden="true"></div>
            <div class="relative w-72 sm:w-80 lg:w-[400px] aspect-[3/4] rounded-xl overflow-hidden shadow-2xl">
              <img
                src="/images/me.jpg"
                alt="Emily Rose Doud"
                class="w-full h-full object-cover object-top"
              />
              <!-- Subtle vignette -->
              <div class="absolute inset-0 bg-gradient-to-t from-brown/40 via-transparent to-transparent"></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 reveal reveal-delay-4" aria-hidden="true">
      <div class="w-0.5 h-10 bg-gradient-to-b from-transparent to-cream/40 animate-pulse"></div>
      <p class="text-label text-cream/30">scroll</p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       VINTAGE TICKER
  ═══════════════════════════════════════════════ -->
  <div class="bg-brown border-y border-brown-mid overflow-hidden py-3 select-none" aria-hidden="true">
    <div class="flex whitespace-nowrap" style="animation: ticker 30s linear infinite;">
      {[1, 2].map(() => (
        <span class="flex items-center shrink-0">
          {[
            'Freelance Writing', 'Photography', 'Journalism',
            'Emily Doud Photography', 'Senior Portraits', 'Waupaca County Post',
            'Brand Photography', 'Headshots', 'Storytelling',
            'Portrait Sessions', 'Feature Writing', 'Creative Writing',
          ].map(item => (
            <span class="flex items-center gap-4 px-6">
              <span class="font-serif text-xl font-bold tracking-widest text-cream italic">{item}</span>
              <span class="text-rose-deep text-sm">✦</span>
            </span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <style>
    @keyframes ticker {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>

  <!-- ═══════════════════════════════════════════════
       FULL-BLEED PHOTO
  ═══════════════════════════════════════════════ -->
  <div class="relative h-[60vh] overflow-hidden">
    <img
      src="/images/lunar-eclipse.jpg"
      alt="Lunar eclipse"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-brown-deep/40"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-end text-center px-6 pb-12">
      <p class="font-display text-display-lg text-white leading-tight">DOUD <em class="not-italic text-white">Co</em></p>
      <p class="text-white/80 text-label mt-3 tracking-widest">Writing · Photography</p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════
       SERVICES STRIP
  ═══════════════════════════════════════════════ -->
  <section class="border-y border-cream-200 bg-cream-50 overflow-hidden">
    <div class="section-padded py-16">
      <div class="container-content">
        <p class="text-label text-center mb-10 reveal">What I Do</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">

          {[
            {
              icon: '✍️',
              label: 'Writing',
              desc: 'Freelance journalism, feature writing, and creative work. Currently contributing to the Waupaca County Post.',
              href: '#writing',
              color: 'from-rose-pale to-cream',
            },
            {
              icon: '📷',
              label: 'Photography',
              desc: 'Editorial, portrait, and lifestyle photography with a warm, intentional eye.',
              href: '/photography',
              color: 'from-cream-200 to-cream',
            },
          ].map((service, i) => (
            <a
              href={service.href}
              class={`card p-6 bg-gradient-to-br ${service.color} group reveal reveal-delay-${i + 1}`}
            >
              <span class="text-2xl mb-4 block">{service.icon}</span>
              <h3 class="font-serif text-lg text-brown mb-2 group-hover:text-rose-deep transition-colors">
                {service.label}
              </h3>
              <p class="text-body text-sm">{service.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       WRITING
  ═══════════════════════════════════════════════ -->
  <section id="writing" class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <div>
          <p class="text-label mb-4 reveal">Writing</p>
          <h2 class="font-display text-display-md text-brown ruled-heading mb-8 reveal reveal-delay-1">
            Freelance &amp; Journalism
          </h2>
          <p class="text-body-lg mb-6 reveal reveal-delay-2">
            I write for newspapers and publications, covering local stories and community
            events with an honest, human-first approach. My work is currently appearing in
            the Waupaca County Post.
          </p>
          <p class="text-body mb-8 reveal reveal-delay-3">
            Creative writing is also in the works — with a book on the horizon.
          </p>
          <a
            href="https://www.waupacanow.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary reveal reveal-delay-3"
          >
            Read My Work at Waupaca County Post →
          </a>
        </div>

        <div class="reveal reveal-delay-2">
          <div class="card p-8 bg-gradient-to-br from-rose-pale to-cream">
            <p class="font-serif text-2xl text-brown italic mb-4">"Stories worth telling."</p>
            <p class="text-body text-sm">
              Freelance journalism · Feature writing · Creative writing in progress
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA BAND
  ═══════════════════════════════════════════════ -->
  <section class="section-padded bg-brown text-cream relative overflow-hidden">
    <div class="absolute inset-0 bg-noise opacity-40" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-rose-deep/20 -translate-y-1/2 translate-x-1/4" aria-hidden="true"></div>
    <div class="relative container-content text-center">
      <p class="text-label text-cream/50 mb-4 reveal">Let's Connect</p>
      <h2 class="font-display text-display-lg text-cream mb-6 reveal reveal-delay-1">
        Ready to work together?
      </h2>
      <p class="text-body-lg text-cream/70 max-w-lg mx-auto mb-10 reveal reveal-delay-2">
        Whether you need a writer, a photographer, or both —
        I'd love to hear from you.
      </p>
      <div class="flex flex-wrap justify-center gap-4 reveal reveal-delay-3">
        <a target="_blank" rel="noopener noreferrer" href={CONTACT_URL} class="btn-primary bg-rose-deep hover:bg-rose-mid">
          Get in Touch
        </a>
        <a href="/about" class="btn-ghost border-cream/30 text-cream hover:border-rose-light hover:text-rose-light">
          My Background
        </a>
      </div>
    </div>
  </section>

</Page>
