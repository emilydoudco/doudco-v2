---
import Page from '../layouts/Page.astro';
import { CONTACT_URL } from '../config/contact';
---

<Page
  title="Doud Co."
  description="IT & Security services, photography, and graphic design. Emily Doud Photography — by Emily Rose Doud."
>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">

    <!-- Layered background -->
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-br from-cream via-cream-100 to-cream-200"></div>
      <!-- Botanical tints -->
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-bl from-sage-pale/30 via-transparent to-transparent"></div>
      <div class="absolute bottom-0 left-0 w-2/3 h-1/2 bg-gradient-to-tr from-rose-pale/20 via-transparent to-transparent"></div>
      <!-- Noise grain overlay -->
      <div class="absolute inset-0 bg-noise opacity-60"></div>
    </div>

    <!-- Decorative circle -->
    <div
      class="hidden lg:block absolute -right-24 top-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border border-sage/20"
      aria-hidden="true"
    ></div>
    <div
      class="hidden lg:block absolute -right-32 top-1/2 -translate-y-1/2 w-[720px] h-[720px] rounded-full border border-rose-deep/10"
      aria-hidden="true"
    ></div>

    <div class="relative section-padded w-full">
      <div class="container-content grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <!-- Copy -->
        <div>
          <p class="text-label mb-6 reveal">IT · Security · Creative Services</p>

          <h1 class="font-display text-display-xl text-brown leading-[1.05] mb-6 reveal reveal-delay-1">
            Emily Doud<br />
            <em class="text-rose-deep not-italic">Photography.</em>
          </h1>

          <p class="text-body-lg max-w-md mb-10 reveal reveal-delay-2">
            Hi, I'm Emily — IT specialist, security enthusiast, and visual storyteller.
            Doud Co. is where <em>technical rigor</em> meets <em>creative eye</em>.
          </p>

          <div class="flex flex-wrap gap-4 reveal reveal-delay-3">
            <a href="/about" class="btn-primary">Meet Emily</a>
            <a href="/photography" class="btn-ghost">Photography</a>
            <a href="/it-support" class="btn-ghost">IT Support</a>
          </div>
        </div>

        <!-- Portrait placeholder — swap in your logo/photo -->
        <div class="relative flex justify-center lg:justify-end reveal reveal-delay-2">
          <div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-[420px] lg:h-[420px]">
            <!-- Outer decorative ring -->
            <div class="absolute inset-0 rounded-full border-2 border-rose-deep/20 animate-[spin_30s_linear_infinite]"></div>
            <!-- Botanical illustration placeholder -->
            <div class="absolute inset-4 rounded-full bg-gradient-to-br from-sage-pale via-cream to-rose-pale flex items-center justify-center overflow-hidden shadow-rose">
                <img
                src="/images/logo.jpg"
                alt="Doud Co. — Emily Rose Doud, illustrated portrait surrounded by roses and ethernet cables"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 reveal reveal-delay-4" aria-hidden="true">
      <div class="w-0.5 h-10 bg-gradient-to-b from-transparent to-brown-light animate-pulse"></div>
      <p class="text-label text-brown-light/60" style="writing-mode: horizontal-tb;">scroll</p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       VINTAGE TICKER
  ═══════════════════════════════════════════════ -->
  <div class="bg-brown border-y border-brown-mid overflow-hidden py-3 select-none" aria-hidden="true">
    <div class="flex whitespace-nowrap" style="animation: ticker 30s linear infinite;">
      {[1, 2].map(() => (
        <span class="flex items-center shrink-0">
          {[
            'IT Support', 'Photography', 'Graphic Design',
            'Cybersecurity', 'Emily Doud Photography', 'Senior Portraits',
            'Brand Photography', 'Headshots', 'Network Troubleshooting',
            'Posters', 'Mailers', 'Company Newsletters',
          ].map(item => (
            <span class="flex items-center gap-4 px-6">
              <span class="font-serif text-xl font-bold tracking-widest text-cream italic">{item}</span>
              <span class="text-rose-deep text-sm">✦</span>
            </span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <style>
    @keyframes ticker {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>

  <!-- ═══════════════════════════════════════════════
       SERVICES STRIP
  ═══════════════════════════════════════════════ -->
  <section class="border-y border-cream-200 bg-cream-50 overflow-hidden">
    <div class="section-padded py-16">
      <div class="container-content">
        <p class="text-label text-center mb-10 reveal">What I Do</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">

          {[
            {
              icon: '🛡',
              label: 'IT Support',
              desc: 'Hardware diagnostics, OS installs, network troubleshooting, and everyday tech help.',
              href: '/it-support',
              color: 'from-rose-pale to-cream',
            },
            {
              icon: '📷',
              label: 'Photography',
              desc: 'Editorial, portrait, and lifestyle photography with a warm, intentional eye.',
              href: '/photography',
              color: 'from-cream-200 to-cream',
            },
            {
              icon: '✦',
              label: 'Graphic Design',
              desc: 'Branding, print, and digital design that tells your story beautifully.',
              href: '/graphic-design',
              color: 'from-rose-pale/50 to-sage-pale/30',
            },
          ].map((service, i) => (
            <a
              href={service.href}
              class={`card p-6 bg-gradient-to-br ${service.color} group reveal reveal-delay-${i + 1}`}
            >
              <span class="text-2xl mb-4 block">{service.icon}</span>
              <h3 class="font-serif text-lg text-brown mb-2 group-hover:text-rose-deep transition-colors">
                {service.label}
              </h3>
              <p class="text-body text-sm">{service.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       CASE STUDIES TEASER
  ═══════════════════════════════════════════════ -->
  <section class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <div>
          <p class="text-label mb-4 reveal">Client Work</p>
          <h2 class="font-display text-display-md text-brown ruled-heading mb-8 reveal reveal-delay-1">
            Case Studies
          </h2>
          <p class="text-body-lg mb-4 reveal reveal-delay-2">
            Real problems, documented solutions. Each case study walks through the problem,
            the diagnostic process, and the outcome — honest about what worked and why.
          </p>
          <div class="flex flex-wrap gap-3 mb-8 reveal reveal-delay-3">
            <span class="tag-rose">IT Support</span>
            <span class="tag-sage">macOS</span>
            <span class="tag-brown">Diagnostics</span>
            <span class="tag-rose">MDM</span>
          </div>
          <a href="/case-studies" class="btn-primary reveal reveal-delay-3">
            View Case Studies →
          </a>
        </div>

        <div class="grid gap-4 reveal reveal-delay-2">
          <div class="card p-6">
            <h3 class="font-serif text-lg text-brown mb-1">The Missing Operating System</h3>
            <p class="text-body text-sm">Diagnosing and recovering a 2017 MacBook Pro that lost its bootable system.</p>
          </div>
          <div class="card p-6">
            <h3 class="font-serif text-lg text-brown mb-1">The Mystery of the Mac with Limited Function</h3>
            <p class="text-body text-sm">Diagnosing internet access restrictions on a 2011 iMac from a former commercial environment.</p>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Also explore -->
  <section class="py-8 border-t border-cream-200">
    <div class="container-content flex flex-wrap justify-center gap-6">
      <a href="/it-support" class="text-label text-brown-light hover:text-rose-deep transition-colors">IT Support →</a>
      <a href="/soc-lab" class="text-label text-brown-light hover:text-rose-deep transition-colors">SOC Lab →</a>
      <a href="/operation-closet-computer" class="text-label text-brown-light hover:text-rose-deep transition-colors">Operation Closet Computer →</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA BAND
  ═══════════════════════════════════════════════ -->
  <section class="section-padded bg-brown text-cream relative overflow-hidden">
    <div class="absolute inset-0 bg-noise opacity-40" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-rose-deep/20 -translate-y-1/2 translate-x-1/4" aria-hidden="true"></div>
    <div class="relative container-content text-center">
      <p class="text-label text-cream/50 mb-4 reveal">Let's Connect</p>
      <h2 class="font-display text-display-lg text-cream mb-6 reveal reveal-delay-1">
        Ready to work together?
      </h2>
      <p class="text-body-lg text-cream/70 max-w-lg mx-auto mb-10 reveal reveal-delay-2">
        Whether you need IT support, creative work, or beautiful photography —
        I'd love to hear from you.
      </p>
      <div class="flex flex-wrap justify-center gap-4 reveal reveal-delay-3">
        <a target="_blank" rel="noopener noreferrer" href={CONTACT_URL} class="btn-primary bg-rose-deep hover:bg-rose-mid">
          Get in Touch
        </a>
        <a href="/about" class="btn-ghost border-cream/30 text-cream hover:border-rose-light hover:text-rose-light">
          My Background
        </a>
      </div>
    </div>
  </section>

</Page>
