---
import Page from '../layouts/Page.astro';
import { CONTACT_URL } from '../config/contact';
---

<Page
  title="Doud Co"
  description="Freelance writing, journalism, and photography by Emily Rose Doud."
>

  <!-- ═══════════════════════════════════════════════
       FULL-BLEED PHOTO
  ═══════════════════════════════════════════════ -->
  <div class="relative h-[70vh] overflow-hidden">
    <img
      src="/images/lunar-eclipse.jpg"
      alt="Lunar eclipse"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-brown-deep/40"></div>

    <!-- Rotating photo panel — left side -->
    <div class="absolute left-6 sm:left-12 lg:left-24 top-1/2 -translate-y-1/2 w-40 sm:w-56 lg:w-72 aspect-[3/4] rounded-xl overflow-hidden shadow-2xl ring-2 ring-rose-deep/30">
      {[
        '/images/photography/claire-1.jpg',
        '/images/photography/claire-2.jpg',
        '/images/photography/claire-3.jpg',
        '/images/photography/claire-4.jpg',
        '/images/photography/claire-6.jpg',
        '/images/photography/claire-7.jpg',
        '/images/photography/cassie.jpg',
        '/images/photography/marley-1-edited.jpg',
        '/images/photography/marley-2-edited.jpg',
        '/images/photography/cover.jpg',
        '/images/photography/for-site-1.jpg',
        '/images/photography/for-site-2.jpg',
        '/images/photography/landscape-1.jpg',
        '/images/photography/landscape-2.jpg',
        '/images/photography/landscape-3.jpg',
        '/images/photography/landscape-4.jpg',
        '/images/photography/landscape-5.jpg',
        '/images/photography/landscape-6.jpg',
        '/images/photography/landscape-7.jpg',
        '/images/photography/landscape-bird.jpg',
        '/images/photography/news-1.jpg',
        '/images/photography/news-2.jpg',
        '/images/photography/news-3.jpg',
        '/images/photography/news-4.jpg',
        '/images/photography/pup.jpg',
        '/images/photography/pup-1.jpg',
        '/images/photography/pup-3.jpg',
        '/images/photography/claire-5.jpg',
        '/images/photography/family-4.jpg',
        '/images/photography/family-5.jpg',
        '/images/photography/family-7.jpg',
        '/images/photography/family-8.jpg',
        '/images/photography/family-9.jpg',
        '/images/photography/family-10.jpg',
      ].map((src, i) => (
        <img
          src={src}
          alt="Photography by Emily Doud"
          class={`photo-reel absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
          data-index={i}
        />
      ))}
    </div>

    <!-- DOUD Co bottom -->
    <div class="absolute inset-x-0 bottom-0 flex items-end justify-center pb-10">
      <h2 class="font-display leading-none" style="font-size: clamp(3.5rem, 12vw, 9rem);">
        <span class="text-cream">DOUD </span><span class="text-rose-deep">Co</span>
      </h2>
    </div>
  </div>

  <script>
    const photos = Array.from(document.querySelectorAll<HTMLImageElement>('.photo-reel'));
    // Fisher-Yates shuffle so order is random each load
    for (let i = photos.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [photos[i], photos[j]] = [photos[j], photos[i]];
    }
    let current = 0;
    photos[0].classList.replace('opacity-0', 'opacity-100');
    setInterval(() => {
      photos[current].classList.replace('opacity-100', 'opacity-0');
      current = (current + 1) % photos.length;
      photos[current].classList.replace('opacity-0', 'opacity-100');
    }, 3000);
  </script>

  <!-- ═══════════════════════════════════════════════
       STAGE LIGHTS + QUOTE
  ═══════════════════════════════════════════════ -->
  <div class="relative overflow-hidden bg-black py-24">

    <!-- Spotlight beams -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="stage-beam" style="left:8%;background:linear-gradient(180deg,rgba(180,80,60,0.55) 0%,transparent 80%);animation:beam 2.1s ease-in-out infinite;"></div>
      <div class="stage-beam" style="left:22%;background:linear-gradient(180deg,rgba(120,60,30,0.5) 0%,transparent 75%);animation:beam 1.7s ease-in-out infinite 0.4s;"></div>
      <div class="stage-beam" style="left:38%;background:linear-gradient(180deg,rgba(220,160,80,0.4) 0%,transparent 85%);animation:beam 2.5s ease-in-out infinite 0.9s;"></div>
      <div class="stage-beam" style="left:54%;background:linear-gradient(180deg,rgba(180,80,60,0.45) 0%,transparent 80%);animation:beam 1.9s ease-in-out infinite 0.2s;"></div>
      <div class="stage-beam" style="left:68%;background:linear-gradient(180deg,rgba(100,45,20,0.55) 0%,transparent 75%);animation:beam 2.3s ease-in-out infinite 0.7s;"></div>
      <div class="stage-beam" style="left:82%;background:linear-gradient(180deg,rgba(200,100,50,0.4) 0%,transparent 85%);animation:beam 1.6s ease-in-out infinite 1.1s;"></div>
    </div>

    <!-- Quote -->
    <div class="relative container-content px-6">
      <p id="typewriter-quote" class="font-serif text-cream/90 italic mb-4" style="font-size:clamp(1.2rem,3vw,2rem); min-height:3em;"></p>
      <p id="typewriter-attr" class="text-rose-light text-label tracking-widest opacity-0 transition-opacity duration-700">— Henry David Thoreau</p>
    </div>
  </div>

  <script>
    const lines = [
      `"Go confidently in the direction of your dreams.`,
      `Live the life you have imagined."`,
    ];
    const words = lines.join('\n').split(' ');
    const el = document.getElementById('typewriter-quote')!;
    const attr = document.getElementById('typewriter-attr')!;
    let i = 0;
    // Cursor span
    const cursor = document.createElement('span');
    cursor.textContent = '|';
    cursor.style.cssText = 'animation:blink 0.7s step-end infinite;margin-left:2px;color:rgba(180,80,60,0.9);';
    el.appendChild(cursor);

    const interval = setInterval(() => {
      if (i < words.length) {
        const word = words[i];
        if (word.includes('\n')) {
          const parts = word.split('\n');
          cursor.before(document.createTextNode((i === 0 ? '' : ' ') + parts[0]));
          cursor.before(document.createElement('br'));
          if (parts[1]) cursor.before(document.createTextNode(parts[1]));
        } else {
          cursor.before(document.createTextNode((i === 0 ? '' : ' ') + word));
        }
        i++;
      } else {
        clearInterval(interval);
        cursor.remove();
        attr.classList.remove('opacity-0');
      }
    }, 120);
  </script>

  <style>
    .stage-beam {
      position: absolute;
      top: 0;
      width: 12%;
      height: 100%;
      clip-path: polygon(40% 0%, 60% 0%, 100% 100%, 0% 100%);
    }
    @keyframes beam {
      0%, 100% { opacity: 0.15; }
      50%       { opacity: 1; }
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50%       { opacity: 0; }
    }
  </style>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative min-h-[95vh] flex items-center overflow-hidden bg-brown">

    <!-- Background texture -->
    <div class="absolute inset-0 bg-noise opacity-30" aria-hidden="true"></div>
    <!-- Warm glow -->
    <div class="absolute top-0 right-0 w-2/3 h-full bg-gradient-to-bl from-rose-deep/20 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-1/2 h-1/2 bg-gradient-to-tr from-brown-deep/40 via-transparent to-transparent" aria-hidden="true"></div>

    <div class="relative section-padded w-full py-20">
      <div class="container-content flex flex-col items-center text-center gap-10">

        <!-- Circle logo -->
        <div class="relative w-56 h-56 sm:w-72 sm:h-72 lg:w-80 lg:h-80 reveal">
          <div class="absolute inset-0 rounded-full border-2 border-rose-deep/30 animate-[spin_30s_linear_infinite]"></div>
          <div class="absolute inset-4 rounded-full overflow-hidden shadow-2xl ring-1 ring-rose-deep/20">
            <img
              src="/images/me.jpg"
              alt="Emily Rose Doud"
              class="w-full h-full object-cover object-top"
            />
          </div>
        </div>

        <!-- Phrases -->
        <div class="reveal reveal-delay-1">
          <p class="text-rose-light text-label tracking-[0.3em] mb-4">Emily Rose Doud</p>
          <div class="w-12 h-px bg-rose-deep mx-auto mb-6"></div>
          <p class="text-cream/90 font-serif italic mb-3" style="font-size: clamp(1.25rem, 3vw, 2rem);">
            "The story is always in the details."
          </p>
          <p class="text-cream/60 mb-10" style="font-size: clamp(1rem, 2vw, 1.25rem);">
            Freelance writer &amp; journalist · Photographer · Wisconsin-based
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/about" class="btn-primary bg-rose-deep hover:bg-rose-mid border-rose-deep">Meet Emily</a>
            <a href="https://www.emilydoudphotography.com" target="_blank" rel="noopener noreferrer" class="btn-ghost border-cream/30 text-cream hover:border-rose-light hover:text-rose-light">Photography →</a>
          </div>
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 reveal reveal-delay-4" aria-hidden="true">
      <div class="w-0.5 h-10 bg-gradient-to-b from-transparent to-cream/40 animate-pulse"></div>
      <p class="text-label text-cream/30">scroll</p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       VINTAGE TICKER
  ═══════════════════════════════════════════════ -->
  <div class="bg-brown border-y border-brown-mid overflow-hidden py-3 select-none" aria-hidden="true">
    <div class="flex whitespace-nowrap" style="animation: ticker 30s linear infinite;">
      {[1, 2].map(() => (
        <span class="flex items-center shrink-0">
          {[
            'Freelance Writing', 'Photography', 'Journalism',
            'Emily Doud Photography', 'Senior Portraits', 'Waupaca County Post',
            'Brand Photography', 'Headshots', 'Storytelling',
            'Portrait Sessions', 'Feature Writing', 'Creative Writing',
          ].map(item => (
            <span class="flex items-center gap-4 px-6">
              <span class="font-serif text-xl font-bold tracking-widest text-cream italic">{item}</span>
              <span class="text-rose-deep text-sm">✦</span>
            </span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <style>
    @keyframes ticker {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
  </style>

  <!-- ═══════════════════════════════════════════════
       SERVICES STRIP
  ═══════════════════════════════════════════════ -->
  <section class="border-y border-cream-200 bg-cream-50 overflow-hidden">
    <div class="section-padded py-16">
      <div class="container-content">
        <p class="text-label text-center mb-10 reveal">What I Do</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto">

          {[
            {
              icon: '✍️',
              label: 'Writing',
              desc: 'Freelance journalism, feature writing, and creative work. Currently contributing to the Waupaca County Post.',
              href: '#writing',
              color: 'from-rose-pale to-cream',
            },
            {
              icon: '📷',
              label: 'Photography',
              desc: 'Editorial, portrait, and lifestyle photography with a warm, intentional eye.',
              href: '/photography',
              color: 'from-cream-200 to-cream',
            },
          ].map((service, i) => (
            <a
              href={service.href}
              class={`card p-6 bg-gradient-to-br ${service.color} group reveal reveal-delay-${i + 1}`}
            >
              <span class="text-2xl mb-4 block">{service.icon}</span>
              <h3 class="font-serif text-lg text-brown mb-2 group-hover:text-rose-deep transition-colors">
                {service.label}
              </h3>
              <p class="text-body text-sm">{service.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       WRITING
  ═══════════════════════════════════════════════ -->
  <section id="writing" class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">

        <div>
          <p class="text-label mb-4 reveal">Writing</p>
          <h2 class="font-display text-display-md text-brown ruled-heading mb-8 reveal reveal-delay-1">
            Freelance &amp; Journalism
          </h2>
          <p class="text-body-lg mb-6 reveal reveal-delay-2">
            I write for newspapers and publications, covering local stories and community
            events with an honest, human-first approach. My work is currently appearing in
            the Waupaca County Post.
          </p>
          <p class="text-body mb-8 reveal reveal-delay-3">
            Creative writing is also in the works — with a book on the horizon.
          </p>
          <a
            href="https://www.waupacanow.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary reveal reveal-delay-3"
          >
            Read My Work at Waupaca County Post →
          </a>
        </div>

        <div class="reveal reveal-delay-2">
          <div class="card p-8 bg-gradient-to-br from-rose-pale to-cream">
            <p class="font-serif text-2xl text-brown italic mb-4">"Stories worth telling."</p>
            <p class="text-body text-sm">
              Freelance journalism · Feature writing · Creative writing in progress
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA BAND
  ═══════════════════════════════════════════════ -->
  <section class="section-padded bg-brown text-cream relative overflow-hidden">
    <div class="absolute inset-0 bg-noise opacity-40" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-rose-deep/20 -translate-y-1/2 translate-x-1/4" aria-hidden="true"></div>
    <div class="relative container-content text-center">
      <p class="text-label text-cream/50 mb-4 reveal">Let's Connect</p>
      <h2 class="font-display text-display-lg text-cream mb-6 reveal reveal-delay-1">
        Ready to work together?
      </h2>
      <p class="text-body-lg text-cream/70 max-w-lg mx-auto mb-10 reveal reveal-delay-2">
        Whether you need a writer, a photographer, or both —
        I'd love to hear from you.
      </p>
      <div class="flex flex-wrap justify-center gap-4 reveal reveal-delay-3">
        <a target="_blank" rel="noopener noreferrer" href={CONTACT_URL} class="btn-primary bg-rose-deep hover:bg-rose-mid">
          Get in Touch
        </a>
        <a href="/about" class="btn-ghost border-cream/30 text-cream hover:border-rose-light hover:text-rose-light">
          My Background
        </a>
      </div>
    </div>
  </section>

</Page>
