---
import Page from '../layouts/Page.astro';
import { CONTACT_URL } from '../config/contact';

const services = [
  { title: 'Hardware Diagnostics',   desc: 'Troubleshooting desktops, laptops, and peripherals — from boot failures to hardware assessment.' },
  { title: 'OS Install & Recovery',  desc: 'Full wipes, fresh installs, and recovery for Windows and macOS systems.' },
  { title: 'Network Troubleshooting', desc: 'Diagnosing connectivity issues, router configuration, and basic network setup.' },
  { title: 'Security Hardening',     desc: 'Removing malware, updating systems, and setting up basic security best practices.' },
  { title: 'Data Backup & Transfer', desc: 'Safely migrating files, setting up backup solutions, and recovering accessible data.' },
  { title: 'General Tech Support',   desc: 'Software installs, printer setup, email configuration, and everyday tech problems.' },
];
---

<Page title="IT Support" description="Hands-on IT support for individuals and small businesses — diagnostics, repair, and tech help by Emily Rose Doud.">

  <!-- Hero -->
  <section class="section-padded pb-section-sm">
    <div class="container-content">
      <p class="text-label mb-4 reveal">Services</p>
      <h1 class="font-display text-display-lg text-brown mb-6 reveal reveal-delay-1">IT Support</h1>
      <p class="text-body-lg max-w-2xl reveal reveal-delay-2">
        Hands-on tech help for individuals and small businesses. Whether your computer won't
        start or you just need someone who speaks plain English — I've got you.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <h2 class="font-display text-display-md text-brown ruled-heading mb-10 reveal">What I Can Help With</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s, i) => (
          <div class={`card p-6 reveal reveal-delay-${Math.min(i + 1, 4)}`}>
            <h3 class="font-serif text-lg text-brown mb-2">{s.title}</h3>
            <p class="text-body text-sm">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hourly & As-Needed -->
  <section class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <div class="mb-10 reveal">
        <h2 class="font-display text-display-md text-brown ruled-heading mb-2">Hourly & As-Needed</h2>
        <p class="text-body text-brown-light">For one-off fixes, upgrades, and clients not on a managed plan.</p>
      </div>

      <div class="space-y-4 max-w-3xl reveal reveal-delay-1">
        {[
          { label: 'Business IT Support',            desc: 'Troubleshooting, repairs, setup & configuration',         price: '$65',  unit: '/ hr' },
          { label: 'Residential & Home Office',      desc: 'Computers, networks, and devices for home users',         price: '$50',  unit: '/ hr' },
          { label: 'Cybersecurity Services',         desc: 'Security assessments, hardening, incident response',      price: '$100', unit: '/ hr' },
          { label: 'After-Hours & Emergency Support',desc: 'Evenings, weekends, and urgent same-day response',        price: '$100', unit: '/ hr' },
          { label: 'Diagnostic & Assessment',        desc: 'Full review of the issue with a clear repair plan',       price: '$79',  unit: 'flat' },
        ].map(row => (
          <div class="flex items-center justify-between gap-4 py-4 border-b border-cream-200 last:border-0">
            <div>
              <p class="font-serif text-lg text-brown">{row.label}</p>
              <p class="text-body text-sm">{row.desc}</p>
            </div>
            <div class="text-right shrink-0">
              <span class="font-display text-2xl text-rose-deep">{row.price}</span>
              <span class="text-label ml-1">{row.unit}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="text-body text-sm text-brown-light italic mt-6 max-w-2xl reveal reveal-delay-2">One-hour minimum on hourly services, then billed in 15-minute increments. The diagnostic fee is credited toward your repair when you proceed with the recommended work.</p>
    </div>
  </section>

  <!-- Managed IT Plans -->
  <section class="section-padded">
    <div class="container-content">
      <div class="mb-4 reveal">
        <h2 class="font-display text-display-md text-brown ruled-heading mb-2">Managed IT Plans</h2>
        <p class="text-body text-brown-light">Predictable monthly support that keeps your business running — priced per user.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6 reveal reveal-delay-1">

        <!-- Essentials -->
        <div class="card p-8">
          <p class="text-label mb-3">Essentials</p>
          <p class="font-display text-5xl text-brown mb-1">$99</p>
          <p class="text-body text-sm mb-6">/ user / mo</p>
          <ul class="space-y-2">
            {['System & network monitoring', 'Security patching & updates', 'Help desk support, business hours', 'Endpoint antivirus protection', 'Monthly performance check-in'].map(item => (
              <li class="text-body text-sm flex gap-2"><span class="text-sage-dark">○</span>{item}</li>
            ))}
          </ul>
        </div>

        <!-- Professional -->
        <div class="card p-8 border-2 border-rose-deep relative">
          <span class="tag-rose absolute -top-3 left-1/2 -translate-x-1/2 text-xs">Most Popular</span>
          <p class="text-label mb-3">Professional</p>
          <p class="font-display text-5xl text-rose-deep mb-1">$149</p>
          <p class="text-body text-sm mb-6">/ user / mo</p>
          <p class="text-body text-sm font-medium mb-3">Everything in Essentials, plus:</p>
          <ul class="space-y-2">
            {['Proactive maintenance & tune-ups', 'Automated cloud backup', 'Advanced endpoint security', 'Priority response times', 'Hardware & software asset tracking'].map(item => (
              <li class="text-body text-sm flex gap-2"><span class="text-rose-deep">○</span>{item}</li>
            ))}
          </ul>
        </div>

        <!-- Complete -->
        <div class="card p-8">
          <p class="text-label mb-3">Complete</p>
          <p class="font-display text-5xl text-brown mb-1">$199</p>
          <p class="text-body text-sm mb-6">/ user / mo</p>
          <p class="text-body text-sm font-medium mb-3">Everything in Professional, plus:</p>
          <ul class="space-y-2">
            {['Managed cybersecurity & threat monitoring', 'After-hours support included', 'Quarterly IT strategy review', 'Vendor & subscription management'].map(item => (
              <li class="text-body text-sm flex gap-2"><span class="text-sage-dark">○</span>{item}</li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-body text-sm text-brown-light italic reveal reveal-delay-2">Plans billed monthly · 3-user minimum · Custom plans available for larger teams and multi-site offices.</p>
    </div>
  </section>

  <!-- Projects & Creative -->
  <section class="section-padded">
    <div class="container-content">
      <div class="mb-8 reveal">
        <h2 class="font-display text-display-md text-brown ruled-heading mb-2">Projects & Creative</h2>
        <p class="text-body text-brown-light">Scoped individually so you only pay for what your project needs.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl mb-8 reveal reveal-delay-1">
        {[
          'New device & workstation setup',
          'Website design & maintenance',
          'Network design, installation & Wi-Fi',
          'Graphic design & branding',
          'Data backup & recovery solutions',
          'Email & cloud migration',
        ].map(item => (
          <div class="flex gap-2 text-body text-sm"><span class="text-rose-deep font-bold">+</span>{item}</div>
        ))}
      </div>
      <p class="text-body text-sm text-brown-light italic reveal reveal-delay-2">Every project gets a written estimate before any work begins — quotes are always free.</p>
    </div>
  </section>

  <!-- Case Studies link -->
  <section class="section-padded border-t border-cream-200">
    <div class="container-content">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <div>
          <p class="text-label mb-3 reveal">Client Work</p>
          <h2 class="font-display text-display-md text-brown ruled-heading mb-6 reveal reveal-delay-1">Case Studies</h2>
          <p class="text-body-lg mb-8 reveal reveal-delay-2">
            Real problems, documented solutions. See how I diagnose and resolve IT issues from start to finish.
          </p>
          <a href="/case-studies" class="btn-primary reveal reveal-delay-3">View Case Studies →</a>
        </div>
        <div class="grid gap-4 reveal reveal-delay-2">
          <div class="card p-6">
            <h3 class="font-serif text-lg text-brown mb-1">The Missing Operating System</h3>
            <p class="text-body text-sm">Diagnosing and recovering a 2017 MacBook Pro that lost its bootable system.</p>
          </div>
          <div class="card p-6">
            <h3 class="font-serif text-lg text-brown mb-1">The Mystery of the Mac with Limited Function</h3>
            <p class="text-body text-sm">Diagnosing internet access restrictions on a 2011 iMac from a former commercial environment.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padded bg-cream-50 border-t border-cream-200">
    <div class="container-content text-center">
      <h2 class="font-display text-display-md text-brown mb-6 reveal">Need Help?</h2>
      <p class="text-body-lg max-w-md mx-auto mb-8 reveal reveal-delay-1">
        Describe what's going on and I'll let you know if I can help — no jargon, no pressure.
      </p>
      <a target="_blank" rel="noopener noreferrer" href={CONTACT_URL} class="btn-primary reveal reveal-delay-2">
        Get in Touch →
      </a>
    </div>
  </section>

</Page>
