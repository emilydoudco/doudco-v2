---
import Page from '../layouts/Page.astro';
---

<Page title="About" description="Meet Emily Rose Doud — freelance writer, journalist, and photographer behind Doud Co.">

  <!-- Page hero -->
  <section class="section-padded pb-0">
    <div class="container-content">
      <p class="text-label mb-4 reveal">About</p>
      <h1 class="font-display text-display-lg text-brown mb-6 reveal reveal-delay-1">
        Emily Rose Doud
      </h1>
      <p class="text-body-lg max-w-2xl reveal reveal-delay-2">
        Freelance writer, journalist, and photographer. Storytelling in every form.
      </p>
    </div>
  </section>

  <!-- Bio + photo -->
  <section class="section-padded">
    <div class="container-content grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-16">
      <div class="lg:col-span-2 space-y-6">
        <h2 class="font-display text-display-md text-brown ruled-heading reveal">My Story</h2>
        <p class="text-body reveal reveal-delay-1">
          I'm Emily — a writer and photographer based in Wisconsin. Words and images have always
          been how I make sense of the world, and over time they became the work.
        </p>
        <p class="text-body reveal reveal-delay-2">
          My journalism background keeps me grounded in accuracy, curiosity, and telling stories
          that actually matter to real people. I freelance for newspapers and am working toward
          a larger goal: writing a book.
        </p>
        <p class="text-body reveal reveal-delay-3">
          I hold a Bachelor's Degree from UW–Eau Claire in Political Science with a minor in
          Print Journalism. My camera goes wherever the story does.
        </p>
      </div>

      <!-- Photo -->
      <div class="reveal reveal-delay-2">
        <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-card">
          <img
            src="/images/emily.jpg"
            alt="Emily Rose Doud"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="section-padded bg-cream-50 border-y border-cream-200">
    <div class="container-content">
      <h2 class="font-display text-display-md text-brown ruled-heading mb-10 reveal">Education</h2>
      <div class="card p-6 max-w-md reveal reveal-delay-1">
        <span class="tag-brown mb-4 inline-block">Political Science · Print Journalism Minor</span>
        <h3 class="font-serif text-xl text-brown">Bachelor's Degree, UW–Eau Claire</h3>
      </div>
    </div>
  </section>

</Page>
